<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_auxiliary_wizard_form" model="ir.ui.view">
        <field name="name">account.auxiliary.wizard.form</field>
        <field name="model">account.auxiliary.wizard</field>
        <field name="arch" type="xml">
            <form string="Balance">
                <sheet>
                    <group>
                        <group>
                            <field name="report_type"/>
                            <label for="date_from" string="Date"/>
                            <div class="o_row">
                                <div class="o_row">
                                    <field name="date_from" required="1"/>
                                </div>
                                <field name="date_to" required="1"/>
                            </div>
                            <field name="group_by_partner" invisible="1"/>
                        </group>
                        <group>
                            <field name="line_state"/>
                            <field name="currency_by" groups="base.group_multi_currency"/>
                            <field name="no_zero"/>
                            <field name="account_by"/>
                            <field name="partner_by"/>
                            <field name="group_by" invisible="0"/>
                        </group>
                    </group>
                    <group string="Filters">
                        <group string="Accounts">
                            <field name="accounts_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Partners">
                            <field name="partners_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="View" class="btn-primary" name="preview_html" type="object"/>
                    or
                    <button string="Confirm" class="btn-primary" name="action_confirm" type="object"/>
                    or
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_auxiliary_wizard" model="ir.actions.act_window">
        <field name="name">Auxiliary Balance</field>
        <field name="res_model">account.auxiliary.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_account_auxiliary_root" name="Informes Auxiliares" parent="account.menu_finance_reports"/>
    <menuitem id="menu_account_auxiliary_wizard" name="Balance Auxiliar" action="action_account_auxiliary_wizard" parent="menu_account_auxiliary_root"/>
</odoo>
