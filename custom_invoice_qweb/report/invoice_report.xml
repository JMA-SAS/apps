<odoo>
    <!-- Template del reporte -->
    <template id="report_invoice_custom_document">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <div class="page">
                    <t t-call="custom_invoice_qweb.invoice_template"/>
                </div>
            </t>
        </t>
    </template>

    <!-- Acción del reporte -->
    <report
        id="action_report_invoice_custom"
        model="account.move"
        string="Factura Personalizada"
        report_type="qweb-pdf"
        name="custom_invoice_qweb.report_invoice_custom_document"
        file="custom_invoice_qweb.report_invoice_custom_document"
        print_report_name="'Factura %s' % (object.name)"
    />

    <!-- Formato de papel -->
    <record id="paperformat_invoice_custom" model="report.paperformat">
        <field name="name">Factura Personalizada</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
    </record>
</odoo>

